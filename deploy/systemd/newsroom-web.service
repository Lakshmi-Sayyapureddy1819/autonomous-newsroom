[Unit]
Description=Autonomous Newsroom web app (FastAPI, 127.0.0.1:8000)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=newsroom
Group=newsroom
WorkingDirectory=/opt/newsroom/app
EnvironmentFile=/etc/newsroom.env
ExecStart=/opt/newsroom/venv/bin/uvicorn newsroom.main:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/newsroom

[Install]
WantedBy=multi-user.target
